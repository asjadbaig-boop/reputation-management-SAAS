# Copy this file to .env.local and fill in the values.

# Supabase → Project Settings → API (Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys (anon / public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API Keys (service_role key) — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for /admin (placeholder auth until per-business accounts)
ADMIN_PASSWORD=

# Low-rating (1-3 star) email alerts via Resend (resend.com → API Keys). Optional:
# if either is empty, alerts are skipped with a console warning and scans still record.
RESEND_API_KEY=
ALERT_EMAIL=
# Optional sender. Defaults to onboarding@resend.dev, which only delivers to your own
# Resend account email — set this to an address on a domain you've verified in Resend.
ALERT_FROM_EMAIL=

# Public base URL encoded in QR codes. Defaults to http://localhost:3000 if empty;
# set to your real domain (e.g. https://reviews.example.com) in production.
NEXT_PUBLIC_SITE_URL=
